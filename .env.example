# Copy this file to .env and fill in values. Never submit real keys.

# LLM — use OpenAI (previous labs) and/or Groq (Llama 3, as in the lecture)
OPENAI_API_KEY=sk-your-openai-api-key-here
GROQ_API_KEY=gsk-your-groq-api-key-here
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.1-8b-instant
# Keep this 1 so Tavily/Aviationstack/weather APIs run without burning LLM tokens.
MINIMAL_TOKENS=1

# Flight specialist — local Aviationstack MCP (STDIO)
AVIATIONSTACK_API_KEY=your-aviationstack-api-key-here

# Hotel specialist — remote Tavily MCP (Streamable HTTP)
# Official remote server: https://mcp.tavily.com/mcp/
TAVILY_API_KEY=your-tavily-api-key-here
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# Weather specialist — local custom MCP (STDIO) uses wttr.in by default (no key).
# Optional OpenWeatherMap key if you prefer that backend:
OPENWEATHER_API_KEY=

# PostgreSQL
# Homebrew (this machine): unix/local user, port 5432
# DATABASE_URL=postgresql://humerashaikh@localhost:5432/travel_planner
# Docker Compose alternative (port 5433):
# DATABASE_URL=postgresql://travel:travel@localhost:5433/travel_planner
DATABASE_URL=postgresql://humerashaikh@localhost:5432/travel_planner

# Optional: force the hotel MCP fallback server port
HOTEL_MCP_PORT=8765
